{
  "name": "@pablopunk/webr",
  "version": "0.2.0",
  "description": "Control your Herdr agents from anywhere.",
  "keywords": [
    "herdr",
    "agents",
    "terminal",
    "web-ui",
    "remote",
    "cli"
  ],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/pablopunk/webr#readme",
  "bugs": {
    "url": "https://github.com/pablopunk/webr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablopunk/webr.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "webr": "bin/webr.mjs"
  },
  "files": [
    "bin",
    "server",
    "src/server",
    "src/shared",
    "src/lib",
    "drizzle",
    "dist"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "astro build",
    "start": "tsx server/start.ts",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "icons": "tsx scripts/build-icons.ts",
    "validate:offline": "tsx scripts/validate-protocol.ts",
    "prepack": "astro build",
    "smoke:install": "tsx scripts/smoke-install.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/react": "7.0.0",
    "@base-ui/react": "1.8.0",
    "@fastify/middie": "9.3.4",
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "11.3.1",
    "@tanstack/react-query": "5.104.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "astro": "7.3.5",
    "bot-avatars": "0.1.2",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "uqr": "0.1.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.8"
  }
}
