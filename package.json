{
  "name": "@pablopunk/webr",
  "version": "0.8.18",
  "description": "Control your Herdr agents from anywhere.",
  "keywords": [
    "herdr",
    "agents",
    "terminal",
    "web-ui",
    "remote",
    "cli"
  ],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/pablopunk/webr#readme",
  "bugs": {
    "url": "https://github.com/pablopunk/webr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablopunk/webr.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "webr": "bin/webr.mjs"
  },
  "files": [
    "bin",
    "server",
    "src/server",
    "src/shared",
    "src/lib",
    "drizzle",
    "dist"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "version": "node scripts/sync-plugin-version.mjs && git add plugin/herdr-plugin.toml",
    "dev": "tsx scripts/dev.ts",
    "build": "astro build",
    "start": "tsx server/start.ts",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "icons": "tsx scripts/build-icons.ts",
    "harness-icons": "tsx scripts/fetch-harness-icons.ts",
    "validate:offline": "tsx scripts/validate-protocol.ts",
    "prepack": "astro build",
    "smoke:install": "tsx scripts/smoke-install.ts",
    "screenshots": "tsx scripts/screenshots/capture.ts",
    "screenshots:serve": "tsx scripts/screenshots/serve.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.1",
    "@base-ui/react": "1.9.0",
    "@fastify/middie": "9.3.6",
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "@tanstack/react-query": "5.104.5",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "astro": "7.4.2",
    "bot-avatars": "0.1.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "uqr": "0.1.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.8"
  }
}
