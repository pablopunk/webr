---
import Base from '../../layouts/Base.astro';
import App from '../../components/App';
const bootstrap = Astro.locals.runtime.bootstrap();
const thread = bootstrap.threads.find((thread) => thread.id === Astro.params.id);
if (!thread) Astro.response.status = 404;
---
<Base title={thread?.title ?? 'Thread not found'}>
  <App page={thread ? 'thread' : 'missing'} threadId={Astro.params.id} bootstrap={bootstrap} client:load transition:persist="herdr-app" />
</Base>
