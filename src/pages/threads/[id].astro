---
import Base from '../../layouts/Base.astro';
import App from '../../components/App';
const bootstrap = Astro.locals.runtime.bootstrap(Astro.locals.accountId);
const thread = bootstrap.threads.find((thread) => thread.id === Astro.params.id);

---
<Base title={thread?.title ?? 'Opening thread…'}>
  <App bootstrap={bootstrap} initialUrl={Astro.url.href} client:load transition:persist="webr-app" />
</Base>
