---
import Base from '../layouts/Base.astro';
import App from '../components/App';
const bootstrap = Astro.locals.runtime.bootstrap(Astro.locals.accountId, Astro.locals.resourceAccountId);
---
<Base title="New thread">
  <App bootstrap={bootstrap} initialUrl={Astro.url.href} client:load transition:persist="webr-app" />
</Base>
