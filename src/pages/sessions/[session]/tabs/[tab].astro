---
import Base from '../../../../layouts/Base.astro';
import App from '../../../../components/App';
const bootstrap = Astro.locals.runtime.bootstrap();
const machineId = Astro.url.searchParams.get('machine');
const thread = machineId ? bootstrap.threads.find((item) => item.machineId === machineId && item.session === Astro.params.session && item.tabId === Astro.params.tab) : undefined;
if (!thread) Astro.response.status = 404;
---
<Base title={thread?.title ?? 'Tab not found'}>
  <App page={thread ? 'thread' : 'missing'} threadId={thread?.id} bootstrap={bootstrap} client:load transition:persist="herdr-app" />
</Base>
