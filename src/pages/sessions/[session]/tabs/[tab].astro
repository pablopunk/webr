---
import Base from '../../../../layouts/Base.astro';
import App from '../../../../components/App';
import { decodeSessionTabId, resolveSessionTab } from '../../../../server/runtime/session-tab';
const manager = Astro.locals.runtime;
const machineId = Astro.url.searchParams.get('machine');
const session = Astro.params.session ?? '';
const tabId = decodeSessionTabId(Astro.params.tab);
const route = resolveSessionTab(manager, session, machineId, tabId, Astro.locals.accountId);
const { bootstrap, thread, terminalTab } = route;
---
<Base title={thread?.title ?? terminalTab?.label ?? 'Opening terminal…'}>
  <App bootstrap={bootstrap} initialUrl={Astro.url.href} client:load transition:persist="webr-app" />
</Base>
