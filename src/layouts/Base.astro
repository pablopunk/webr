---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import monoFont from '../assets/fonts/jetbrains-mono.woff2?url';
const { title = 'Webr' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f8f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121313" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Webr" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title} · Webr</title>
    <link rel="preload" as="font" type="font/woff2" href={monoFont} crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      function restoreWebrTheme() {
        let preference = 'system';
        try { preference = localStorage.getItem('webr-theme') || 'system'; } catch {}
        document.documentElement.dataset.theme = preference === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : preference;
      }
      restoreWebrTheme();
      document.addEventListener('astro:before-swap', (event) => { event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme; });
      document.addEventListener('astro:after-swap', restoreWebrTheme);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
